# Copy to .env and fill in real values. Generate a key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Set to true in production behind HTTPS.
COOKIE_SECURE=false

# Omit locally to use SQLite. In production, Railway's Postgres plugin
# injects this automatically — just reference it as ${{Postgres.DATABASE_URL}}
# in the backend service's variables.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
